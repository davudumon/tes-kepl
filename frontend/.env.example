# Salin file ini menjadi frontend/.env lalu sesuaikan bila perlu.
# Vite hanya membaca variabel berawalan VITE_ dan menyisipkannya saat build.
#
# WAJIB diisi: alamat endpoint JSON Laravel (prefix /api, bukan URL penuh ke
# /api/tasks). Aplikasi gagal start dengan pesan jelas bila variabel ini kosong.
VITE_API_URL=http://localhost:8000/api
